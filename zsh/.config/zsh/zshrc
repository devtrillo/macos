function nvimvenv (){
  if [[ -e "$VIRTUAL_ENV" && -f "$VIRTUAL_ENV/bin/activate" ]]; then
    source "$VIRTUAL_ENV/bin/activate"
    command nvim "$@"
    deactivate
  else
    command nvim "$@"
  fi
}

lt-worktree() {
  local id=${1:?Usage: lt-worktree <story-id>}
  local branch worktree

  branch=$(
    curl -fsS \
      'https://app.litetracker.com/api/v1/projects/c5c439/my_work/stories?query=1263&page=1' \
      --cookie "_litetracker_store=$(pass pivotal-tracker/cookie)" |
      jq -r --arg id "$id" '.records[]
        | select((.id | tostring) == $id)
        | "\(.id)  \(.title)"
        | ascii_downcase
        | gsub("[: ]"; "_")
        | gsub("[^a-z0-9_]"; "")' |
      vipe
  ) || return

  [[ -n $branch ]] || {
    echo "Story not found: $id" >&2
    return 1
  }

  worktree="$HOME/lifelink/worktrees/${PWD##*/}-${id:0:6}"
  mkdir -p "${worktree:h}"

  git worktree add -b "$branch" "$worktree" &&
    cd "$worktree"
}
 
